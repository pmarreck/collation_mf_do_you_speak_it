#!/usr/bin/env bash
# Master test runner for romantic_collation.
# Runs Zig unit tests + CLI integration tests.
# Exit code = total number of failures across all suites.
#
# Per Mecha conventions: never use `set -euo pipefail` in test scripts.
# `set -e` silently aborts when a command-under-test returns non-zero, which
# masks the intended-failure paths.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOTAL_FAIL=0
TOTAL_PASS=0

run_suite() {
	local name="$1"
	local cmd="$2"
	echo ""
	echo "━━━ $name ━━━"
	local output
	output=$(eval "$cmd" 2>&1)
	local rc=$?
	local pass fail
	# Recognize multiple summary formats:
	#   - shell-style "N passed" / "N failed"
	#   - Zig --summary all success: "N/N tests passed"
	#   - Zig --summary all failure: "N pass, N fail (M total)"
	pass=$(echo "$output" | grep -oE '[0-9]+(/[0-9]+)?( tests?)? pass(ed)?' | head -1 | grep -oE '^[0-9]+' || echo "0")
	fail=$(echo "$output" | grep -oE '[0-9]+( tests?)? fail(ed)?' | head -1 | grep -oE '^[0-9]+' || echo "0")
	if [[ $rc -ne 0 && "$fail" == "0" ]]; then
		fail=1
	fi
	TOTAL_PASS=$((TOTAL_PASS + pass))
	TOTAL_FAIL=$((TOTAL_FAIL + fail))
	echo "$output" | tail -8
}

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║   romantic_collation Master Test Suite                       ║"
echo "╚══════════════════════════════════════════════════════════════╝"

# Build first (ReleaseFast for CLI tests; nix-sandboxed).
echo ""
echo "Building (ReleaseFast)..."
"$SCRIPT_DIR/build" 2>&1 | tail -3 \
	|| { echo "FATAL: build failed"; exit 1; }

# Zig unit tests — `--summary all` makes Zig emit "N/N tests passed"
# which run_suite's grep can pick up.
run_suite "Zig Unit Tests" "nix develop -c zig build test --summary all 2>&1"

# Integration tests (CLI surface) — add as they're written
for t in "$SCRIPT_DIR"/tests/integration/*.sh; do
	[[ -f "$t" ]] || continue
	run_suite "Integration: $(basename "$t")" "bash '$t'"
done

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  TOTAL: $TOTAL_PASS passed, $TOTAL_FAIL failed"
echo "╚══════════════════════════════════════════════════════════════╝"

exit $TOTAL_FAIL
